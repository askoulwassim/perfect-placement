{
  "name": "@perfect-placement/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server generated from the ops registry (stdio + Streamable HTTP).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fake-run-op.d.ts",
      "default": "./dist/testing/fake-run-op.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@perfect-placement/contracts": "workspace:*",
    "zod": "^4.6.5",
    "@perfect-placement/fixtures": "workspace:*"
  },
  "bin": {
    "pp-mcp": "./dist/bin.js"
  }
}

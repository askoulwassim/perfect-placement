    "better-sqlite3": "^13.0.3",
    "docx": "^9.13.0",
    "pdfkit": "^0.20.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@perfect-placement/fixtures": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pdfkit": "^0.17.6"
  }

{
  "name": "@perfect-placement/engine",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Mechanics: db, ops registry handlers, status machine, profile, scoring, freshness, people, integrations.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

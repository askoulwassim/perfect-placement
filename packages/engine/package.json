      "types": "./testing/index.ts",
      "default": "./testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@perfect-placement/contracts": "workspace:*",

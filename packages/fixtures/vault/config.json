{
  "policy": {
    "auto": 0.9,
    "second_opinion": 0.7,
    "undo_hours": 24
  },
  "overrides": {
    "freshness.closed": {
      "auto": 0.92
    },
    "profile.apply_diff": {
      "confident_outcome": "auto_undo"
    },
    "inbox.classify": {
      "confident_outcome": "auto_undo"
    }
  },
  "backends": {
    "default": "kev",
    "fallback": "agent",
    "kev": {
      "baseUrl": "http://127.0.0.1:8009"
    },
    "jev": {
      "baseUrl": "",
      "keyEnv": "JEV_API_KEY",
      "enabled": false
    },
    "agent": {}
  },
  "scoring": {
    "affinity_cap": 5,
    "company_active_cap": 3,
    "green_min": 75,
    "yellow_min": 55
  },
  "scout": {
    "watchlist_share_max": 0.34,
    "target_new_roles": 25,
    "max_queries": 30
  },
  "runner": {
    "command": "claude"
  },
  "linkedin": {
    "mode": "live",
    "driver": "claude-in-chrome",
    "max_profiles_per_day": 40,
    "max_pages_per_run": 6,
    "max_mutual_expansions": 3,
    "min_delay_s": 20
  },
  "freshness": {
    "stale_after_days": 45
  },
  "runs": {
    "max_concurrent": 2
  },
  "pipeline": {
    "score_after_scout": true,
    "research_after_score": true
  },
  "schedules": {
    "inbox": "daily 07:30",
    "freshness": "daily 06:30",
    "scout_score": "fri 05:30"
  },
  "ui": {
    "cues_seen": []
  }
}

  "files": [
    "dist",
    "seed",
    "vault"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen": "tsc -p tsconfig.build.json && node dist/generate.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@perfect-placement/contracts": "workspace:*"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "@types/better-sqlite3": "^9.6.0"
  }
}
